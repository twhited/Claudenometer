# Cronometer credentials
CRONOMETER_EMAIL=your@email.com
CRONOMETER_PASSWORD=yourpassword

# Timezone offset in minutes from UTC (e.g. -300 = UTC-5 Eastern, 0 = UTC)
CRONOMETER_TZ_OFFSET=0

# Transport: stdio (for Claude Desktop, default) or sse (for remote/Docker)
TRANSPORT=stdio

# SSE mode settings (only used when TRANSPORT=sse)
HOST=0.0.0.0
PORT=8000

# API key for SSE endpoint authentication — required when TRANSPORT=sse
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-strong-random-key
